{
  "name": "pathguru-publishers",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered publishing suite. Produces KDP-ready PDF and EPUB from a single prompt.",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --env-file=.env.local --env-file=.env backend/server.js",
    "prepare": "husky",
    "guard": "node scripts/guard-staged.mjs",
    "lint:staged": "lint-staged",
    "check": "node --check backend/server.js",
    "install-playwright": "npx playwright install --with-deps chromium",
    "test":         "node ./tests/skills.test.js",
    "test:blog":    "node --env-file=.env scripts/test-blog.mjs",
    "test:review":  "node --env-file=.env scripts/test-blog.mjs --review",
    "test:cms":     "node scripts/e2e-cms.mjs",
    "test:agents":  "node scripts/e2e-agents.mjs",
    "test:desktop-smoke": "node scripts/e2e-desktop-smoke.mjs",
    "publish:post": "node --env-file=.env scripts/publish-html-post.mjs",
    "delete:post":  "node --env-file=.env scripts/delete-post.mjs",
    "seed:digifusion": "node --env-file=.env.local scripts/seed-digifusion-content.mjs",
    "desktop:dev": "electron desktop/main.js",
    "desktop:build": "electron-builder --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "dotenv": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.4.168",
    "playwright": "^1.39.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "*.{js,mjs}": "node --check"
  }
}
