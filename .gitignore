# Environment variables — never commit these
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/

# Playwright browsers
/ms-playwright/

# Build outputs & temp files
dist/
/tmp/

# Generated documents — large files, not source code
*.pdf
*.epub
*.docx
*.xlsx
*.pptx

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Staging folder for files the device bridge cannot delete — never commit
_to_delete/
*.tar.gz

# IDE tooling — never commit
.cursor/
.continue/
.cline/

# Scratch artefacts
tmp-*
*.probe
.probe*
.buildprobe

# Patch script backups
*.bak
